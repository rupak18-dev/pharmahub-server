# PharmaHub Server — environment variables
# Copy to `.env` for local development. All values shown are the defaults.

# Port for the HTTP server
PORT=5000

# MongoDB connection string. REQUIRED on Render/Vercel/any remote host.
# Use the standard mongodb+srv:// form when connecting to MongoDB Atlas:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
# (The explicit seed-list form is only needed on networks where Node's DNS
# resolver is broken — see frontend .env.local notes.)
MONGO_URI=mongodb://127.0.0.1:27017/pharmahub

# JWT signing secret — use a long random value in production
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# Allowed CORS origin ("*" allows all)
CORS_ORIGIN=*

# Request rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Node environment: development | test | production
NODE_ENV=development
