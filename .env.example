# PharmaHub Backend Configuration Template
PORT=5050
NODE_ENV=development
MONGO_URI=mongodb+srv://...
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
PASSWORD_RESET_TTL_MS=3600000
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@pharmahub.com

# Demo account passwords (code defaults exist for local dev only; set these in shared/prod environments)
DEMO_ACCOUNT_PASSWORD=change-me-demo-password
DEV_DEMO_PASSWORD=change-me-dev-password
