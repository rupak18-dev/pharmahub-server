# PharmaHub Backend Configuration Template
PORT=5050
NODE_ENV=development
MONGO_URI=mongodb+srv://...
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
PASSWORD_RESET_TTL_MS=3600000
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
# ── Email delivery ────────────────────────────────────────────────────────────
# Two mutually exclusive providers. If RESEND_API_KEY is a NON-EMPTY value,
# Resend is used and every SMTP_* value below is ignored. A RESEND_API_KEY that
# is set but EMPTY does NOT enable Resend — it silently falls back to SMTP.
#
# Recommended (Resend): works from Render/cloud hosts, unlike Gmail SMTP.
# 1. Resend dashboard → Domains → Add Domain, then add the DNS records it gives
#    you and wait for status "verified".
# 2. Resend dashboard → API Keys → Create API Key, copy the re_... value.
# 3. Set both values below and redeploy.
# Startup contacts the Resend API and logs an ERROR if the key is rejected or
# the EMAIL_FROM domain is not verified — check the deploy log after changing
# these.
RESEND_API_KEY=
EMAIL_FROM="PharmaHub <noreply@your-verified-domain.com>"

# NOTE: the default sender is PharmaHub <onboarding@resend.dev>, which only
# delivers to the Resend account owner's own address. Always set EMAIL_FROM to a
# verified domain or production mail will be rejected.

# SMTP fallback — only used when RESEND_API_KEY is unset or empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=PharmaHub

# Dev-only: surface the OTP as `devCode` in the register/resend response when
# email delivery is not configured. Ignored in production. Off by default.
EMAIL_DEV_CODE=false

# TEST deployments only: allow the devCode echo above even when the service
# runs with NODE_ENV=production (e.g. Render free tier with no working SMTP
# egress). NEVER set this on real production services.
EMAIL_DEV_CODE_PROD=false

# Demo-account passwords for @pharmahub.* / demo@pharmahub.local auto-login.
# No code defaults exist — without these, demo auto-login returns 401.
# Ignored in production.
DEMO_ACCOUNT_PASSWORD=change-me-demo-password
DEV_DEMO_PASSWORD=change-me-dev-password
