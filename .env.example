# Server
PORT=5000
NODE_ENV=development

# MongoDB (required in production — set MONGO_URI on the host, e.g. Render dashboard -> Environment)
MONGO_URI=mongodb://127.0.0.1:27017/pharmahub

# Auth — use a long random string in production
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS - use comma-separated list or * for all
CORS_ORIGIN=*

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
